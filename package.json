{
  "name": "dsh-model-speed",
  "version": "0.1.0",
  "type": "module",
  "description": "Live generation speed and token usage of the models configured in this DSH profile — one minimal dock row, no extra panels.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model",
    "speed",
    "tokens"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
